# === D.8 验证码、身份核验、支付与地理位置 ===
RECAPTCHA_SECRET_KEY=  # reCAPTCHA 服务端密钥
RECAPTCHA_V3_SECRET_KEY=  # reCAPTCHA v3 服务端密钥（v3 站点密钥与 v2 不同，需单独配置）
RECAPTCHA_V3_SCORE_THRESHOLD=  # reCAPTCHA v3 分数阈值（0–1，默认 0.5）
RECAPTCHA_V3_ACTION=  # reCAPTCHA v3 期望 action 标签（留空不校验）
HCAPTCHA_SECRET_KEY=  # hCaptcha 服务端密钥
TURNSTILE_SECRET_KEY=  # Cloudflare Turnstile 服务端密钥
GEETEST_CAPTCHA_ID=  # GeeTest Captcha ID
GEETEST_CAPTCHA_KEY=  # GeeTest Captcha Key
ALIYUN_CAPTCHA_ACCESS_KEY_ID=  # 阿里云验证码 AccessKeyId
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=  # 阿里云验证码 AccessKeySecret
ALIYUN_CAPTCHA_APP_KEY=  # 阿里云验证码 2.0 场景 ID（SceneId，作为 VerifyIntelligentCaptcha 请求参数发送）
TENCENT_CAPTCHA_APP_ID=  # 腾讯云验证码 CaptchaAppId（票据校验 DescribeCaptchaResult 的应用 ID，设置后注册 tencent_captcha）
TENCENT_CAPTCHA_APP_SECRET_KEY=  # 腾讯云验证码 AppSecretKey（服务端票据校验密钥，作为请求参数发送）
TENCENT_CAPTCHA_SECRET_ID=  # 腾讯云 API SecretId（TC3-HMAC-SHA256 请求签名用，非验证码 AppSecretKey）
TENCENT_CAPTCHA_SECRET_KEY=  # 腾讯云 API SecretKey（TC3-HMAC-SHA256 请求签名用，非验证码 AppSecretKey）
NETEASE_YIDUN_CAPTCHA_ID=  # 网易易盾验证码 captchaId（服务端二次校验 /api/v2/verify 的验证码 ID，设置后注册 netease_yidun）
NETEASE_YIDUN_SECRET_ID=  # 网易易盾业务 ID secretId（服务端二次校验公共参数）
NETEASE_YIDUN_SECRET_KEY=  # 网易易盾业务密钥 secretKey（参与请求签名计算） （密钥类字段禁止落库或写入日志）
BAIDU_CAPTCHA_APP_ID=  # 百度安全验证 app_id（服务端校验 /api/v1/check 的应用 ID，设置后注册 baidu_captcha）
BAIDU_CAPTCHA_PRIVATE_KEY=  # 百度安全验证 private_key（参与 MD5 签名计算） （密钥类字段禁止落库或写入日志）
BAIDU_CAPTCHA_APP_NAME=  # 百度安全验证 app_name（可选，服务端校验请求参数）
RECAPTCHA_ENTERPRISE_API_KEY=  # Google reCAPTCHA Enterprise API Key（assessments REST 鉴权 key，设置后注册 recaptcha_enterprise） （密钥类字段禁止落库或写入日志）
RECAPTCHA_ENTERPRISE_SITE_KEY=  # Google reCAPTCHA Enterprise 站点 key（event.siteKey）
RECAPTCHA_ENTERPRISE_PROJECT_ID=  # Google Cloud 项目 ID（assessments 端点路径 projects/{project}）
RECAPTCHA_ENTERPRISE_SCORE_THRESHOLD=  # reCAPTCHA Enterprise 接受分数阈值（缺省 0.5）
RECAPTCHA_ENTERPRISE_ACTION=  # reCAPTCHA Enterprise 期望动作标签（event.expectedAction）
CAPTCHA_STORE_DRIVER=redis  # 本地图形验证码（default / go_captcha）答案存储驱动 （未设置且配置了 REDIS_ADDR 时默认尝试 redis；Ping 不可用 fail-open 回落 memory（多实例不共享答案，见 OPEN 登记））
CAPTCHA_DEFAULT_TYPE=digit  # 本地图形验证码 default provider 的 base64Captcha 驱动类型
CAPTCHA_DEFAULT_LENGTH=6  # 本地图形验证码答案长度（digit/string 生效，math 忽略）
PAYMENT_PROVIDER=  # 支付渠道选择
PAYMENT_APP_ID=  # 支付 App ID （密钥类字段禁止落库或写入日志）
PAYMENT_MCH_ID=  # 支付商户号
PAYMENT_API_KEY=  # 支付 API Key
PAYMENT_PRIVATE_KEY=  # 支付私钥
PAYMENT_PUBLIC_KEY=  # 支付公钥
PAYMENT_MCH_SERIAL_NO=  # 支付商户 API 证书序列号 （微信支付商户 API 证书序列号（非平台证书）；禁止写入日志）
PAYMENT_PLATFORM_CERT_PEM=  # 支付平台证书 PEM （微信支付平台证书 PEM bundle，用于响应与回调验签；禁止写入日志）
PAYMENT_IS_SANDBOX=false  # 支付是否沙箱
PAYMENT_CLIENT_ID=  # 支付渠道客户端 ID （GuliangPay 渠道客户端凭据；由 payment_registry 注入 ChannelGateway，禁止写入日志）
PAYMENT_CLIENT_SECRET=  # 支付渠道客户端密钥 （与 PAYMENT_CLIENT_ID 成对；仅经环境注入（ADR-009 / ADR-021））
ALIPAY_PUBLIC_KEY=  # Alipay 回调验签公钥 （Alipay 回调验签公钥；匿名回调启用前必须配置，禁止写入日志）
WECHAT_PAY_API_V3_KEY=  # WeChat Pay API V3 密钥 （WeChat Pay V3 回调 AEAD 解密密钥；匿名回调启用前必须配置，禁止写入日志）
WECHAT_PAY_PLATFORM_CERTS=  # WeChat Pay 平台证书 PEM （WeChat Pay 平台证书 PEM，用于回调官方验签；证书轮换时由 Secret 更新，禁止写入日志）
STRIPE_WEBHOOK_SECRET=  # Stripe Webhook 签名密钥 （Stripe 官方 Webhook 签名密钥；匿名回调启用前必须配置，禁止写入日志）
IP2REGION_XDB_PATH=  # IP 归属地离线库路径

# === D.9 协议服务与集成 ===
RADIUS_ENABLED=false  # 是否启动 RADIUS
RADIUS_ADDR=:8000  # RADIUS 监听地址
RADIUS_SECRET=  # RADIUS 共享密钥
KRB5_KEYTAB_PATH=  # Kerberos keytab 文件路径
KRB5_REALM=  # Kerberos Realm
KRB5_SERVICE_NAME=  # Kerberos Service Name
ACME_ENABLED=false  # 是否启用 ACME 证书自动签发
ACME_EMAIL=  # ACME 账户邮箱
ACME_STAGING=false  # ACME 是否 staging （字符串 true 时使用 Let's Encrypt 测试环境）
SCIM_ALLOW_PRIVATE_TARGETS=false  # SCIM 出站是否允许私有/回环地址 （默认 false 使用 SSRF 安全 Transport；仅当连接器必须访问内网 SCIM 目标时显式开启）

# === D.10 前端构建变量（VITE_ 前缀，浏览器可见） ===
# VITE_API_BASE_URL=/api/v1  # API 基础地址 （后端 Go 代码与前端构建变量分属两个命名空间）
# VITE_WALLETCONNECT_PROJECT_ID=  # WalletConnect 项目 ID

# === D.11 会话缓存与 Redis（ADR-010 / ADR-017） ===
SESSION_CACHE_DRIVER=memory  # 会话缓存驱动 （redis 驱动不可用时回落 memory 并返回说明性错误，不 panic）
REDIS_ADDR=:8000  # Redis 服务地址（host:port） （redis 驱动必填）
REDIS_PASSWORD=  # Redis 密码
REDIS_DB=0  # Redis 数据库编号
REDIS_POOL_SIZE=0  # Redis 连接池大小 （0 表示使用 go-redis 默认（10 × GOMAXPROCS））
REDIS_MAX_RETRIES=3  # Redis 最大重试次数
REDIS_DIAL_TIMEOUT=2s  # Redis 建连超时（Go duration 字面量）
REDIS_READ_TIMEOUT=2s  # Redis 读超时（Go duration 字面量）
REDIS_WRITE_TIMEOUT=2s  # Redis 写超时（Go duration 字面量）
RATE_LIMIT_REDIS_ADDR=:8000  # 分布式限流专用 Redis 地址 （未设置时限流退化为进程内令牌桶（多实例可被绕过））
RATE_LIMIT_REDIS_PASSWORD=  # 分布式限流专用 Redis 密码
RATE_LIMIT_REDIS_DB=1  # 分布式限流专用 Redis 数据库编号

# === D.12 熔断、可观测与迁移校验 ===
CIRCUIT_FAILURE_THRESHOLD=3  # 熔断器连续失败阈值
CIRCUIT_RECOVERY_INTERVAL=5s  # 熔断器恢复探测间隔（Go duration 字面量）
METRICS_SCRAPE_TOKEN=  # Prometheus /metrics 抓取令牌 （生产必填（缺失时拒绝启动）；非生产未设置时 /metrics 无鉴权暴露并回 X-Warning）
ALLOW_CHECKSUM_DRIFT=  # 开发环境迁移校验和漂移重放开关 （APP_ENV=development 时默认开启并重放变更后的幂等迁移；可显式设为 false 关闭；production 禁止）
SCHEMA_CONTENT_HASH=  # 期望的 schema 内容哈希 （可选钉扎；设置后镜像内结构集哈希不一致即启动失败）
GULIANGIAM_SQL_GUARD_MODE=log  # SQL 注入运行时防御守卫模式（sqlguard 包）；panic 严格模式、log 默认观察期、off 跳过校验

# === Discipline & Red Lines ===
# - 禁止把后端密钥放进 VITE_*（会被打包进浏览器产物）
# - CURSOR_HMAC_KEY / ETAG_HMAC_KEY / SESSION_HMAC_KEY 内置默认值仅允许在非生产环境回落
# - ENCRYPTION_KEY_CURRENT 在所有环境必填，无默认值可回落

