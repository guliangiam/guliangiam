# ============================================================
# GuliangIAM Environment Variables
# Copy this file to .env.local (preferred) or .env and fill in your values.
# NEVER commit real secrets to version control.
# Auto-generated by scripts/gen_env_vars.py — DO NOT EDIT MANUALLY
# Source: contracts/registries/env.yaml
# ============================================================

# === D.1 环境标识与密钥 ===
APP_ENV=development  # 唯一环境标识（ADR-021）；production 触发严格校验
# IS_PRODUCTION=false  # [已废弃] 与 APP_ENV 冲突即拒绝启动 （已废弃的只读同义词；仅用于与 APP_ENV 一致性校验）
SESSION_HMAC_KEY=  # Session Cookie HMAC 密钥（已退役） （已退役（OPEN-API-22）：其唯一消费方 HMAC 签名会话 Cookie 已随 OPEN-API-20 删除；会话来源改为 sessions 仓库行（DB 强制）。保留登记仅为兼容性检查，Go 运行时无读取点）
# SESSION_SECRET=  # [已废弃] ADR-021 决策 2（已退役） （已退役兼容别名（OPEN-API-22）；仅当 SESSION_HMAC_KEY 为空时回退的历史行为已随会话 Cookie 退役而失效）
WEBAUTHN_REQUIRE_UV=false  # WebAuthn ceremony 是否强制用户验证（UV）；作为第二因子/MFA 替代的部署必须开启（开发设计 31.3.2(b)） （取值仅接受 true/false/1/0；其他取值在启动校验中直接失败（拼错的开关等于静默关掉策略））
SESSION_CLEANUP_INTERVAL_MINUTES=60  # 会话清理任务周期（分钟）
SESSION_CLEANUP_RETENTION_HOURS=168  # 已注销会话保留时长（小时）
CLIENT_SECRET_ROTATION_GRACE_HOURS=24  # OAuth client secret 轮换宽限期（小时），窗口内旧 secret 仍可验签 （非正整数按默认 24h 处理；宽限期判定发生在验签时，不引入定时任务）
ENCRYPTION_KEY_CURRENT=  # 当前字段加密密钥（标准 Base64）；AES-256-GCM（缺省，canonical aes-256-gcm，别名 aes/aes256）需 32B，SM4-GCM（canonical sm4-gcm，别名 sm4/gmsm）需 16B；生成为 openssl rand -base64 32（AES）或 openssl rand -base64 16（SM4）；长度不符启动失败 （所有环境必填；缺失时拒绝启动（禁止明文降级））
ENCRYPTION_KEY_PREVIOUS=  # 前一个加密密钥（轮换期间解密旧密文）
ENCRYPTION_KEY_COMPAT=  # 算法切换重叠窗口内另一算法的解密密钥（ENCRYPTION_ALGORITHM 切换时保留旧密文可读） （仅解密；长度由另一算法决定（AES-256=32B、SM4=16B），映射到当前密钥版本）
ENCRYPTION_KEY=  # 非生产环境可回落此变量 （旧版加密密钥向后兼容回落）
PASSWORD_HISTORY_PEPPER=  # 密码历史校验用 pepper （生产必须显式配置；缺失、空白或等于内置开发哨兵时拒绝启动（错误信息不打印该值））
CURSOR_HMAC_KEY=  # 分页游标签名密钥 （生产必须显式配置）
ETAG_HMAC_KEY=  # ETag 签名密钥 （生产必须显式配置）
COOKIE_SECURE=  # Cookie Secure 强制标志 （未设置时 production 默认 true、其他环境默认 false；显式 true/false 可覆盖；非法值按 true 处理（fail-secure）；Secure 与 `__Host-` 前缀同步切换）
ENCRYPTION_ALGORITHM=aes-256-gcm  # 字段加密算法选择 （canonical 值 aes-256-gcm / sm4-gcm；AES 别名 aes、aes256，SM4 别名 sm4、gmsm。国密 sm4-gcm 是显式能力位；取值为不可用算法或未知值时启动失败，不得静默降级。CRYPTO_PROFILE=gm 时未设置本变量默认 sm4-gcm；gm 档显式 aes-256-gcm（或 aes/aes256 别名）启动失败）
CRYPTO_PROFILE=default  # 加密能力档位选择 （gm 档缺少 sm2_sign / sm2_encrypt / sm3 / sm4 时拒绝启动；gm 档强制字段加密 sm4-gcm（未设置 ENCRYPTION_ALGORITHM 时自动选择，显式 AES 拒绝启动）；能力位清单见 contracts/registries/crypto.yaml）
GM_TLS_ENABLED=false  # 国密 TLS 能力位开关 （只是启用声明，不等于可用；能力位由 GM_TLS_SIGN_CERT_FILE / GM_TLS_SIGN_KEY_FILE / GM_TLS_ENC_CERT_FILE / GM_TLS_ENC_KEY_FILE / GM_TLS_CA_FILE 的 SM2 材料自检裁决。未启用或材料缺失/非法只降级（/healthz=degraded + degraded_reasons），不阻断 gm 档启动）
GM_TLS_SIGN_CERT_FILE=  # 国密 TLS 签名证书文件路径 （GM_TLS_ENABLED=true 时必填；PEM 证书，公钥必须为 SM2（OID 1.2.156.10197.1.301），签名算法为 SM2-SM3（OID 1.2.156.10197.1.501））
GM_TLS_SIGN_KEY_FILE=  # 国密 TLS 签名私钥文件路径 （GM_TLS_ENABLED=true 时必填；PEM（PKCS#8 或 SEC1）SM2 私钥，必须与签名证书公钥匹配）
GM_TLS_ENC_CERT_FILE=  # 国密 TLS 加密证书文件路径 （GM_TLS_ENABLED=true 时必填；PEM 证书，公钥必须为 SM2；与签名证书一起构成 GM/T 0024 双证书）
GM_TLS_ENC_KEY_FILE=  # 国密 TLS 加密私钥文件路径 （GM_TLS_ENABLED=true 时必填；PEM（PKCS#8 或 SEC1）SM2 私钥，必须与加密证书公钥匹配）
GM_TLS_CA_FILE=  # 国密 TLS 受信 CA 证书包路径 （GM_TLS_ENABLED=true 时必填；签名证书与加密证书都必须能链到该 PEM CA 包中的 SM2 受信根）
JWT_SIGNING_KEYS_FILE=  # JWT 签名密钥环文件路径（多 kid 持久化与退役重叠窗口） （可选；未设置时：非 production 使用进程内临时密钥并输出 ephemeral signing keys 告警（重启与多副本不一致），production 拒绝启动，除非显式设置 ALLOW_EPHEMERAL_SIGNING_KEYS。文件为 JSON：keys[].kid/algorithm/private_key_pem/created_at/retired_at，可选 overlap（默认 48h，不得小于 2× applications.expire_in_hours 默认 24h）。kid 必须全局唯一且前缀匹配算法（RS256→rsa_、SM2-SM3→gm_）；私钥仅经部署注入，禁止写入仓库、日志或镜像）
ALLOW_EPHEMERAL_SIGNING_KEYS=false  # 显式允许生产环境使用临时 JWT 签名密钥的逃生开关 （仅供 production 在未配置 JWT_SIGNING_KEYS_FILE 时显式放行进程内临时签名密钥；true/1/yes/on 视为开启，其它取值视为关闭。开启后启动 WARN：多副本不共享签名密钥、重启换 kid；仅限单副本或一次性环境，不得作为常规生产配置）
KMS_PROVIDER=none  # 密钥管理提供方选择 （未知取值回退 EnvKeyProvider 并告警——生产必须显式使用 vault 或受管 KMS，不得静默降级（ADR-009 / ADR-015））
VAULT_ADDR=:8000  # Vault 服务地址 （KMS_PROVIDER=vault 时必填；缺失即初始化失败（fail-close））
VAULT_TOKEN=  # Vault 访问令牌 （KMS_PROVIDER=vault 时必填；仅经环境注入，禁止落库/日志/前端（ADR-009））
VAULT_KEYS_PATH=secrets/data/guliangiam/production/keys  # Vault 密钥存储路径前缀 （密钥路径前缀；未显式配置时使用代码默认值）

# === D.2 数据库与连接池（旧版兼容别名） ===
POSTGRES_DSN=  # PostgreSQL 连接串 （DB_DSN 的兼容别名；优先级 DB_DSN > POSTGRES_DSN > DATABASE_URL，仅在高优先级键未设置时生效。非生产环境 .env 会补入该键，从而压过编排层注入的 DATABASE_URL（OPEN-API-45））
DATABASE_URL=  # 备选连接串 （DB_DSN 的兼容别名；优先级最低（DB_DSN > POSTGRES_DSN > DATABASE_URL），仅在前两者未设置时生效）
POSTGRES_MAX_CONNS=  # 连接池最大连接数 （兼容别名，ADR-023）
POSTGRES_MIN_CONNS=  # 连接池最小连接数 （兼容别名，ADR-023）
AUTO_MIGRATE=false  # 是否启动时自动执行迁移 （默认关闭；服务启动可用 -migrate 显式开启（命令行优先），或显式 true/1/yes/on；生产必须 false，迁移由运维显式执行）
AUTO_SEED=false  # 是否自动执行 Seed （默认关闭；服务启动可用 -seed 显式开启（隐含 -migrate），或显式 true/1/yes/on；生产必须 false）
BOOTSTRAP_ADMIN_PASSWORD=  # 内置管理员一次性初始化口令 （仅首次播种、旧默认凭据被撤销后或需替换开发哨兵时必需；不得设置默认值或写入真实口令；12-128 字符且含大小写字母、数字、特殊字符；会替换数据链哨兵，但不覆盖用户自定义的非空哈希；新凭据强制首登改密）
BOOTSTRAP_INTEGRITY_STRICT=true  # 启动完整性校验严格模式开关 （默认严格；账本/种子/管理员凭据基线未自证通过时拒绝启动（SEC-BOOT-INTEGRITY）；仅非生产可显式 false/0 跳过；APP_ENV=production 且显式 false 视为配置错误 fail-fast；不可解析取值直接报错）
POSTGRES_TEST_DSN=  # PostgreSQL 测试连接串 （仅单元测试使用；不参与运行时配置）
GIAM_TEST_PG_DSN=  # SM3 审计链集成测试连接串 （仅真实 PostgreSQL 集成测试使用（GM R2 审计链用例）；不参与运行时配置）
AUDIT_VERIFY_TEST_DSN=  # audit-verify 链校验集成测试连接串 （仅 cmd/audit-verify 集成测试使用；不参与运行时配置）

# === D.3 多数据库方言与驱动（ADR-023） ===
DB_DRIVER=postgres  # 方言选择 （未知值必须启动失败，不得静默回退默认）
DB_DSN=  # 统一连接串 （与 POSTGRES_DSN / DATABASE_URL 三选一；优先级 DB_DSN > POSTGRES_DSN > DATABASE_URL（DB_DSN 最高）。服务启动日志 `postgres DSN source` 只打印生效来源键名，不打印值）
DB_MAX_OPEN_CONNS=  # 连接池最大连接数
DB_MAX_IDLE_CONNS=  # 连接池最大空闲连接数
DB_CONN_MAX_LIFETIME=30m  # 单连接最长存活时长（Go duration 字面量）
MYSQL_DSN=  # MySQL 连接串 （MySQL 方言连接串（DB_DRIVER=mysql 时读取））
MYSQL_URL=  # MySQL URL 格式连接串 （MYSQL_DSN 的 URL 别名）
MYSQL_MAX_OPEN_CONNS=  # MySQL 连接池最大打开连接数
MYSQL_MAX_IDLE_CONNS=  # MySQL 连接池最大空闲连接数

# === D.4 HTTP、服务标识、限流与可观测性 ===
HTTP_ADDR=:8000  # HTTP 监听地址 （优先于 HTTP_PORT）
HTTP_PORT=8000  # HTTP 端口 （未设置 HTTP_ADDR 时生效）
ISSUER_URL=  # JWT issuer 公网 URL
CORS_ALLOWED_ORIGINS=  # 浏览器跨域允许来源白名单 （空=同源不放行；逗号分隔；支持 https://*.父域 通配）
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS  # 预检允许方法白名单
CORS_MAX_AGE=86400  # 预检结果缓存秒数 （0 或非法值回落 86400（Chrome / Firefox 预检缓存上限））
AUTH_PASSWORD_CHANGE_ENFORCEMENT=enforce  # 强制改密门禁模式（warn 只计数与日志；enforce 在请求期拦截未改密会话，按密码状态分别返回 403：need_update_password→password_change_required，max_age_exceeded→password_expired；off 仅登录响应提示） （off|warn|enforce；未设置=默认 enforce；非法值回落 enforce 并记 warn 日志；密码状态按会话缓存 30s）
PASSWORD_BREACH_CHECK_ENABLED=false  # 泄露口令检查开关（AUTH-009 / OPEN-API-85） （true/false/1/0；未设置=false（进程不出域）；拼错在启动校验失败；开启后注册/改密/重置在策略校验后走 HIBP k-匿名 range 查询（仅 SHA-1 前 5 位出域），依赖故障 fail-open 并在审计 payload 标记 breachCheck=unverified）
PASSWORD_BREACH_CHECK_BASE_URL=https://api.pwnedpasswords.com  # HIBP range API 基地址 （空=官方 range API；覆盖用于自建镜像或隔离测试环境；请求超时固定 2s，范围响应缓存 24h（复用 session-cache Redis，无 Redis 回退进程内））
REGION_RESIDENCY_MODE=observe  # 跨 region 数据驻留守卫模式（observe 观察并记录 region_residency_violation；enforce 拒绝跨 region 租户访问） （off|observe|enforce；未设置/非法值=observe（只记结构化 warn，fail-open 便于灰度）；enforce 在跨租户 target 解析后比较双方 region，跨 region 或无绑定返回 403）
TRUSTED_PROXY_CIDRS=  # 反向代理可信 CIDR 列表（客户端 IP 解析） （逗号分隔 CIDR；空=不信任任何代理（生产安全默认）；仅当 RemoteAddr 命中时才采信 X-Forwarded-For/X-Real-IP）
MTLS_PROXY_CLIENT_CERT_HEADER=  # 反向代理传递客户端证书链的头名（RFC 8705 客户端认证） （空=忽略所有转发证书头（安全默认）；非空时必须同时配置 TRUSTED_PROXY_CIDRS，仅当直连 peer 命中该列表时读取；支持 XFCC `Cert="..."` 或裸 URL 编码 PEM；代理必须自行校验客户端证书并覆盖（不得追加）该头；配置了 TLS_CLIENT_CA_FILE 时应用层仍会校验转发来的证书链）
TLS_CERT_FILE=  # 服务端 TLS 证书文件路径 （与 TLS_KEY_FILE 成对设置时进程内终止 TLS；集群部署通常由 Ingress 终止）
TLS_KEY_FILE=  # 服务端 TLS 私钥文件路径
TLS_CLIENT_CA_FILE=  # 客户端证书 CA 包路径（RFC 8705 客户端认证） （进程内 TLS 始终请求客户端证书（RequestClientCert）；设置该 CA 包后，tls_client_auth 用该根校验客户端证书链，未设置时该方式 fail-closed；self_signed_tls_client_auth 仅按登记的指纹匹配；未启用进程内 TLS 时，仅在 MTLS_PROXY_CLIENT_CERT_HEADER 非空下允许单独设置，用于校验代理转发来的证书链）
# RATE_LIMIT_RPM=  # [已废弃] 旧版 RPM （已废弃（ADR-021 第 4 条）；语义并入 RATE_LIMIT_GLOBAL_RATE）
RATE_LIMIT_GLOBAL_RATE=100  # 全局速率（req/s）
RATE_LIMIT_GLOBAL_BURST=200  # 全局突发
RATE_LIMIT_AUTH_RATE=10  # 认证面速率 （req/min；读入时 /60.0 转 per-second）
RATE_LIMIT_AUTH_BURST=5  # 认证面突发 （不是 20——部署指南 compose 示例的 20 是覆盖值）
RATE_LIMIT_AUDIT_DENIAL_RATE=10  # 拒绝审计独立令牌桶速率（events/s）；超限明细丢弃并告警，响应不受影响
RATE_LIMIT_SIGNUP_RATE=5  # 注册速率 （req/min）
RATE_LIMIT_SIGNUP_BURST=3  # 注册突发
RATE_LIMIT_PASSWORD_RESET_RATE=3  # 密码重置速率 （req/min）
RATE_LIMIT_PASSWORD_RESET_BURST=2  # 密码重置突发
RATE_LIMIT_TOKEN_RATE=30  # Token 端点速率 （req/min）
RATE_LIMIT_TOKEN_BURST=10  # Token 端点突发
OAUTH2_TOKEN_RATE_LIMIT_RATE=30  # OAuth2 token 端点族速率（待实现） （目标态（OPEN-API-28）：POST /oauth2/token 端点族速率（req/min））
OAUTH2_TOKEN_RATE_LIMIT_BURST=10  # OAuth2 token 端点族突发（待实现） （目标态（OPEN-API-28）：POST /oauth2/token 端点族突发）
OAUTH2_INTROSPECT_RATE_LIMIT_RATE=600  # OAuth2 introspect 端点族速率（待实现） （目标态（OPEN-API-28）：POST /oauth2/introspect 端点族速率（RS 轮询，req/min））
OAUTH2_INTROSPECT_RATE_LIMIT_BURST=120  # OAuth2 introspect 端点族突发（待实现） （目标态（OPEN-API-28）：POST /oauth2/introspect 端点族突发）
OAUTH2_REVOKE_RATE_LIMIT_RATE=60  # OAuth2 revoke 端点族速率（待实现） （目标态（OPEN-API-28）：POST /oauth2/revoke 端点族速率（req/min））
OAUTH2_REVOKE_RATE_LIMIT_BURST=20  # OAuth2 revoke 端点族突发（待实现） （目标态（OPEN-API-28）：POST /oauth2/revoke 端点族突发）
RATE_LIMIT_OTLP_RATE=200  # OTLP 速率 （req/s）
RATE_LIMIT_OTLP_BURST=400  # OTLP 突发
RATE_LIMIT_PER_IP_REQUESTS=10  # 服务级 per-IP 窗口限流最大请求数
RATE_LIMIT_PER_IP_WINDOW=60  # per-IP 窗口长度（秒）
RATE_LIMIT_PER_IP_CLEANUP_INTERVAL=300  # per-IP 限流器清理间隔（秒）
SENTRY_DSN=  # Sentry 上报地址
SENTRY_ENVIRONMENT=  # Sentry 环境标识
SENTRY_RELEASE=  # Sentry 版本标识
CURSOR_TTL_SECONDS=3600  # 游标有效期（契约 4.7.2） （建议迁入 D4）
CSP_REPORT_TO_URL=  # CSP 违规上报端点（契约 4.17.1） （建议迁入 D4；Report-Only 期内部端点）

# === D.5 对象存储 ===
STORAGE_TYPE=local  # 对象存储类型
STORAGE_LOCAL_BASE_DIR=  # 本地存储目录；同时用于 /uploads/ 静态服务
STORAGE_LOCAL_BASE_URL=  # 本地存储对外 URL 前缀
STORAGE_ACCESS_KEY=  # 云存储访问密钥
STORAGE_SECRET_KEY=  # 云存储密钥
STORAGE_REGION=  # 云存储区域
STORAGE_ENDPOINT=  # 云存储端点
STORAGE_BUCKET=  # 云存储桶
STORAGE_AZURE_ACCOUNT_NAME=  # Azure Blob 账户名
STORAGE_AZURE_ACCOUNT_KEY=  # Azure Blob 账户密钥
STORAGE_AZURE_CONTAINER=  # Azure Blob 容器名
STORAGE_UPLOAD_MAX_BYTES=33554432  # 单文件上传大小上限（契约 4.17.2） （建议迁入 D5；= 32 MiB；超限 413）
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf  # 上传 MIME 白名单（契约 4.17.2） （建议迁入 D5；与扩展名白名单、魔数嗅探三方可比对）
STORAGE_ATTACHMENT_EXTENSIONS=svg,html,htm,js  # 活跃内容防内联 XSS（契约 4.17.2） （建议迁入 D5；强制 Content-Disposition: attachment）
STORAGE_PRESIGN_PUT_TTL_SECONDS=300  # 预签名直传（PUT）有效期（契约 4.17.2） （建议迁入 D5）

# === D.6 邮件与短信渠道 ===
EMAIL_PROVIDER=smtp  # 邮件渠道选择
SMS_PROVIDER=twilio  # 短信渠道选择
SMTP_HOST=  # SMTP 主机
SMTP_PORT=587  # SMTP 端口
SMTP_USERNAME=  # SMTP 用户名
SMTP_PASSWORD=  # SMTP 密码
SMTP_FROM=  # SMTP 发件人
SENDGRID_API_KEY=  # SendGrid API Key
SENDGRID_FROM=  # SendGrid 发件人
RESEND_API_KEY=  # Resend API Key
